{
  "name": "@silentgreen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The hosted verification service: ingest a batch, run the engine, store the result and a ledger entry.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.3",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "silentgreen": "file:../..",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
