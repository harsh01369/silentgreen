# Neon connection string (pooled). From the Neon dashboard.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/silentgreen?sslmode=require

# A long random string. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public URL this API is served from.
BETTER_AUTH_URL=http://localhost:4000

# The web app origin, for CORS and cookies.
WEB_ORIGIN=http://localhost:3000

PORT=4000
NODE_ENV=development
